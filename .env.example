# Settings reference for .env. You do not need Python, pip, or Node on the host, only Docker.
#
# For a new install, do not copy this file. Create .env with new random secrets instead:
#   sh tools/generate-env.sh      (Linux, macOS)
#   pwsh tools/generate-env.ps1   (Windows)
# Then add any optional setting below to .env and run: docker compose up -d
#
# The service refuses to start while a required secret is empty, or while any secret has a publicly known value.
#
# Reach the service from other machines only over HTTPS, through a reverse proxy.
# See "Remote access and HTTPS" in README.md. Behind HTTPS, turn on Secure session cookie
# on the dashboard's Settings page (or set COOKIE_SECURE=true below, which locks it there),
# and set FORWARDED_ALLOW_IPS to the proxy's address or network.

# --- Environment only ---------------------------------------------------------
# The service needs these before it can read its own settings, so they are not on the Settings page.

# Required secrets (the generator fills these). Together they derive the key that encrypts stored secrets.
SESSION_SECRET=
APP_ENCRYPTION_KEY=
# Password of the bundled Redis server. docker-compose.yml builds the default Redis URL from it.
REDIS_PASSWORD=

# Optional: PostgreSQL instead of the default SQLite. Take the password from your secret store.
# DATABASE_URL=postgres://auth:<password>@postgres:5432/authdb

# Optional: a master API key with every scope. Empty or unset means no master key.
# Generate a value with: openssl rand -hex 32
# ADMIN_API_KEY=

# Optional: URL path prefix when a reverse proxy serves the portal under a path, such as /auth.
# It must match the proxy's route.
# ROOT_PATH=

# Optional: addresses of reverse proxies whose X-Forwarded-For header uvicorn trusts
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# --- Overrides of Settings page fields ----------------------------------------
# Each of these is also on the dashboard's Settings page. Set it here only to override the
# saved value: the page then shows the field locked.

# TZ, COOKIE_SECURE and the retention values are copied to the Settings page at each start, so
# removing one later keeps its last value.

# Time zone for dates (default: UTC). Examples: Asia/Jerusalem, America/New_York, Europe/London
# TZ=UTC

# Secure flag on the session cookie. Turn it on when admins use the portal over HTTPS.
# COOKIE_SECURE=false

# Log retention in days, from 1 to 3650 (default: 30). A value outside that range stops the start.
# ACTIVITY_LOG_RETENTION_DAYS=30
# ACCESS_LOG_RETENTION_DAYS=30

# Token validation rate limit per address. Not copied: when you remove one, the page value applies.
# RATE_LIMIT_MAX_REQ=120
# RATE_LIMIT_WINDOW_MS=60000

# Redis connection. Overrides the URL saved on the Settings page and the bundled Redis.
# It is copied to the Settings page once a check against it passes. Remove it only after the
# Settings page no longer says that the environment value is not saved yet.
# REDIS_URL=redis://:<password>@redis:6379

# Passkey address for dashboard sign-in, such as https://auth.example.com (HTTPS, or
# http://localhost). Not copied: when you remove it, the page value applies. Empty: not set.
# PASSKEY_ORIGIN=

# --- Other optional settings --------------------------------------------------

# Name shown in authenticator apps. Used only while the first admin sets up MFA, where the
# setup page can also change it. When set, the setup page shows it locked.
# TOTP_ISSUER=AuthService

# Deprecated: on the first start after the upgrade, an empty zones table gets these zones once.
# The service does not read it after that.
# ALLOWED_AREAS=orders,billing,webhooks
