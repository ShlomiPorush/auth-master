# Settings reference for .env. You do not need Python, pip, or Node on the host, only Docker.
#
# For a new install, do not copy this file. Create .env with new random secrets instead:
#   sh tools/generate-env.sh      (Linux, macOS)
#   pwsh tools/generate-env.ps1   (Windows)
# Then add any optional setting below to .env and run: docker compose up -d
#
# The service refuses to start while a secret is empty or has a publicly known value.
#
# Reach the service from other machines only over HTTPS, through a reverse proxy.
# See "Remote access and HTTPS" in README.md. Behind HTTPS, set COOKIE_SECURE=true so
# session cookies use the Secure flag, and set FORWARDED_ALLOW_IPS to the proxy's
# address or network.
# COOKIE_SECURE=false
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Required secrets (the generator fills these)
ADMIN_API_KEY=
SESSION_SECRET=
APP_ENCRYPTION_KEY=
# Redis authentication password (used by both the bundled Redis server and the app)
REDIS_PASSWORD=

# ALLOWED_AREAS=orders,billing,webhooks

# Optional: PostgreSQL instead of the default SQLite. Take the password from your secret store.
# DATABASE_URL=postgres://auth:<password>@postgres:5432/authdb

# Optional: require X-Bootstrap-Token on first admin registration
# BOOTSTRAP_TOKEN=

# Timezone for date display (default: UTC)
# Examples: Asia/Jerusalem, America/New_York, Europe/London
# TZ=UTC

# Token Validation Rate Limiting (per IP). Also set on the dashboard's Settings page;
# a value here wins there and locks the field.
# RATE_LIMIT_MAX_REQ=120
# RATE_LIMIT_WINDOW_MS=60000

# Log Retention settings in days (default: 30)
# ACTIVITY_LOG_RETENTION_DAYS=30
# ACCESS_LOG_RETENTION_DAYS=30
